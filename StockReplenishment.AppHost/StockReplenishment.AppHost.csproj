<Project Sdk="Aspire.AppHost.Sdk/13.6.1">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StockReplenishment.Api/StockReplenishment.Api.csproj" />
    <ProjectReference Include="../StockReplenishment.Web/StockReplenishment.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Overrides vulnerable version -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>
</Project>
